generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RIDER
  DRIVER
  ADMIN
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       String @id @default(uuid())
  fullName String
  email    String @unique
  password String

  phoneNumber  String?
  profileImage String?

  role       Role    @default(RIDER)
  isVerified Boolean @default(false)
  isBlocked  Boolean @default(false)

  refreshTokenId String?

  // EMAIL OTP
  emailOtp          String?
  emailOtpExpiresAt DateTime?

  driver Driver?
messages Message[]
  riderRides Ride[] @relation("RiderRides")
  ratings Rating[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  cnic          String @unique
  licenseNumber String @unique

  vehicleType   RideCategory
  vehicleModel  String
  vehicleNumber String @unique

  isOnline Boolean @default(false)

  latitude Float?
  longitude Float?

  status DriverStatus @default(PENDING)

  rides Ride[] @relation("DriverRides")

  ratings Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum RideStatus {
  PENDING
  ACCEPTED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED_BY_RIDER
  CANCELLED_BY_DRIVER
}

model Ride {
  id String @id @default(uuid())

  pickup      String
  destination String

  pickupLat     Float?
  pickupLng     Float?
  destinationLat Float?
  destinationLng Float?

  category    RideCategory @default(MINI)
  fare Float?

  status RideStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentIntentId String?

  riderId String
  rider   User   @relation("RiderRides", fields: [riderId], references: [id])
  chat Chat?

  driverId String?
  driver   Driver? @relation("DriverRides", fields: [driverId], references: [id])

  rating Rating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Chat {
  id        String   @id @default(uuid())

  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])

  messages  Message[]

  createdAt DateTime @default(now())
}
model Message {
  id        String   @id @default(uuid())

  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id])

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])

  text      String

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}

model Rating {
  id String @id @default(uuid())

  rideId String @unique
  ride   Ride   @relation(fields: [rideId], references: [id])

  riderId String
  rider   User   @relation(fields: [riderId], references: [id])

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  stars  Int
  review String?

  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  title     String
  message   String

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RideCategory {
  MINI
  RIDE_AC
  PREMIUM
}